SUPABASE_URL=your_public_supabase_url
SUPABASE_ANON_KEY=your_public_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SESSION_EXPIRY=3600  # Optional: Session expiry in seconds, Default is No Expiry
DATABASE_URL=your_postgres_url_port:6543
DATABASE_DIRECT_URL=your_postgres_url_port:5432
# Optional: max postgres.js pool size (default 3 on Supabase session pooler, else 10)
# DATABASE_POOL_MAX=3

# Optional: Docker Swarm / Compose file-based secrets (file wins when set)
# DATABASE_URL_FILE=/run/secrets/database_url
# DATABASE_DIRECT_URL_FILE=/run/secrets/database_direct_url
# SUPABASE_SERVICE_ROLE_KEY_FILE=/run/secrets/supabase_service_role_key
# S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_access_key
# STRIPE_SECRET_KEY_FILE=/run/secrets/stripe_secret_key
# TOOLPATH_API_KEY_FILE=/run/secrets/toolpath_api_key
# POSTMARK_API_TOKEN_FILE=/run/secrets/postmark_api_token
# INTAKE_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/intake_s3_secret_access_key
# RFQ_WEBHOOK_SECRET_FILE=/run/secrets/rfq_webhook_secret

# Local RFQ/S3 integration tests: run `npm run s3mock:local`, then set endpoint/credentials below.
# Full `npm run test:ci` also needs DATABASE_URL pointing at a migrated local Postgres database.
S3_ENDPOINT=your_s3_endpoint
S3_REGION=your_s3_region
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_BUCKET=your_s3_bucket_name

# WordPress RFQ intake (disabled unless exactly "true")
RFQ_INTAKE_ENABLED=false
# Dedicated intake bucket WordPress uploads into. It may live in a different account/provider than
# the application bucket above. When the endpoint, region, and access key match the application
# bucket the ERP copies with a server-side CopyObject; otherwise it streams through the worker.
# All but INTAKE_S3_ENDPOINT (unset for AWS) and INTAKE_S3_REGION (default us-east-1) are required
# by the worker when RFQ_INTAKE_ENABLED=true.
INTAKE_S3_ENDPOINT=your_intake_s3_endpoint
INTAKE_S3_REGION=your_intake_s3_region
INTAKE_S3_ACCESS_KEY_ID=your_intake_s3_access_key_id
INTAKE_S3_SECRET_ACCESS_KEY=your_intake_s3_secret_access_key
INTAKE_S3_BUCKET=your_intake_s3_bucket_name
RFQ_WEBHOOK_SECRET=use_a_unique_secret_per_environment
# Required only by the guarded staging RFQ smoke workflow
STAGING=false

NODE_ENV=development #leave this as development for local testing, remove for prod environment

CONVERSION_API_URL=your_api_url
CONVERSION_API_TIMEOUT=60000  # Timeout in ms (default if not set)
CONVERSION_POLLING_INTERVAL=1000  # In ms (default is 2 seconds)

# Toolpath API
TOOLPATH_API_KEY=tp_test_your_toolpath_api_key

# Email Configuration
POSTMARK_API_TOKEN=your_postmark_token
POSTMARK_MESSAGE_STREAM=outbound
EMAIL_DOMAIN=yourdomain.com,anotherdomain.com

GOOGLE_SERVICE_ACCOUNT_EMAIL=From_key.json
GOOGLE_DELEGATED_USER_EMAIL=account_you_setup_in_workspaces
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=PK_from_key.json
